# Yerel test icin sablon.
#   cp .env.example .env   ve degerleri doldurun
#   .env GITIGNORE'DA — asla commit etmeyin.
#
# Yukleme (PowerShell):
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^\s*([^#][^=]*)=(.*)$') {
#       [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim())
#     }
#   }
#   $env:DRY_RUN="1"; python post_reel.py
#
# Yukleme (bash):
#   set -a && . ./.env && set +a && DRY_RUN=1 python post_reel.py

# --- Instagram (zorunlu) ---
# IG_USER_ID: Instagram Business/Creator hesabinin ID'si (sayfa ID'si DEGIL).
#   Bulmak icin: GET /me/accounts -> sayfa id -> GET /{page-id}?fields=instagram_business_account
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Instagram uygulamasi (opsiyonel ama onerilir) ---
# Bunlar varsa token omru dogru sorgulanir ve refresh_token.py calisir.
IG_APP_ID=
IG_APP_SECRET=

# --- Google Drive (zorunlu) ---
# Service account JSON'unun TAMAMI, tek satirda veya cok satirli.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Klasor ID'si = Drive URL'sindeki /folders/<BU_KISIM>
# UCU DE FARKLI OLMALI.
DRIVE_QUEUE_FOLDER_ID=
DRIVE_PUBLISHED_FOLDER_ID=
DRIVE_FAILED_FOLDER_ID=

# --- Opsiyonel ayarlar (varsayilanlariyla) ---
# DRY_RUN=1                      # Instagram'a hicbir sey gondermez
# GRAPH_VERSION=v23.0
# USER_TAGS=rota,rotaile,ramedyaresmi
# DEFAULT_CAPTION={name}\n\n#rotakesit
# MAX_RETRIES=3
# POLL_TIMEOUT=480
# UPLOAD_TIMEOUT=600
# UPLOAD_ATTEMPTS=3
# STATE_RETENTION_DAYS=90        # state.json temizligi
# PUBLISHED_RETENTION_DAYS=0     # 0=kapali. >0 ise eski dosyalar Drive copune gider

# --- Token yenileme (opsiyonel) ---
# GH_TOKEN=                      # "Secrets: read and write" yetkili PAT
# GH_REPOSITORY=kullanici/rotakesit-reels
# REFRESH_BEFORE_DAYS=15
