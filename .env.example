# Yerel test icin sablon.
#   cp .env.example .env   ve degerleri doldurun
#   .env GITIGNORE'DA - asla commit etmeyin.
#
# Yukleme (bash):
#   set -a && . ./.env && set +a && DRY_RUN=1 python post_reel.py

# --- Instagram (zorunlu) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Instagram uygulamasi (opsiyonel, token yenileme icin) ---
IG_APP_ID=
IG_APP_SECRET=

# --- Google Drive (zorunlu) ---
# Kok klasor ID'si = Drive URL'sindeki /folders/<BU_KISIM>
# published/ ve failed/ alt klasorleri isme gore otomatik bulunur.
DRIVE_ROOT_FOLDER_ID=

# setup_oauth.py bunlari doldurur - elle yazmayin
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Shared Drive kullaniyorsaniz OAuth yerine bunu verebilirsiniz.
# UYARI: kisisel My Drive'da service account dosya olusturamaz/tasiyamaz.
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# --- Opsiyonel ayarlar (varsayilanlariyla) ---
# DRY_RUN=1
# GRAPH_VERSION=v23.0
# USER_TAGS=rota,rotaile,ramedyaresmi
# MAX_RETRIES=3
# POLL_TIMEOUT=480
# UPLOAD_TIMEOUT=600
# UPLOAD_ATTEMPTS=3
# STATE_RETENTION_DAYS=90
# DRIVE_PUBLISHED_FOLDER_ID=   # isme gore bulunamazsa
# DRIVE_FAILED_FOLDER_ID=

# --- Token yenileme (opsiyonel) ---
# GH_TOKEN=
# GH_REPOSITORY=kullanici/rotakesit-reels
# REFRESH_BEFORE_DAYS=15
